# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Access Control
# Set a keyword that students will use to access the app
# They will enter this keyword instead of having direct access to your API key
ACCESS_KEYWORD=your_secret_keyword_here

# Session Management
# Secret for signing session cookies - MUST be changed in production!
# Generate a random string using: openssl rand -base64 32
SESSION_SECRET=change-this-to-random-string-in-production

# This prototype has no application rate/capacity limiter.
# Add gateway quotas and a persistent session store before shared public use.
